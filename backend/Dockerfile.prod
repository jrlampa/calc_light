# ── STAGE 1: Dependências ────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# Instala dependências em ambiente isolado
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ── STAGE 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runner

WORKDIR /app

# Copia pacotes instalados do stage de build
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin/gunicorn /usr/local/bin/gunicorn
COPY --from=builder /usr/local/bin/uvicorn  /usr/local/bin/uvicorn

# Copia o código da aplicação
COPY app ./app

# Cria diretório de dados para o volume de persistência do SQLite
RUN mkdir -p /app/data

# Variáveis de ambiente padrão (sobrescritas pelo docker-compose)
ENV DATABASE_URL=sqlite:////app/data/cacl_light.db \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# Gunicorn com UvicornWorker para concorrência real em produção.
# --workers: recomendado = (2 × núcleos_CPU) + 1; ajuste via GUNICORN_WORKERS.
CMD ["sh", "-c", \
  "gunicorn app.main:app \
     --bind 0.0.0.0:8000 \
     --workers ${GUNICORN_WORKERS:-2} \
     --worker-class uvicorn.workers.UvicornWorker \
     --timeout 120 \
     --access-logfile - \
     --error-logfile -"]
