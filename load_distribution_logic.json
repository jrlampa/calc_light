      "fp_cos": 0.85,
      "fp_sin": 0.5268,
      "formula_K_por_condutor": "K = R × 0.85 + X × 0.5268",
      "formula_celula_exemplo_C{row}": "=C11*0.85+C12*0.5268",
      "descricao": "Coeficiente QDT efetivo considerando FP=0.85 → sin(φ)=0.5268. ΔV% = K × I_A × L_km"
